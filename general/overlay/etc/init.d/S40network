#!/bin/sh

WIFI_TIMEOUT=15

check_wlan_up() {
    ip -4 addr show wlan0 2>/dev/null | grep -q "inet "
}

start() {
    echo "Starting network..."
    ifup lo
    ifup wlan0
	
    i=0
    while [ $i -lt $WIFI_TIMEOUT ]; do
        if check_wlan_up; then
            echo "wlan0 connected, skipping eth0."
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done

    echo "wlan0 not connected after ${WIFI_TIMEOUT}s, falling back to eth0."
    ifup eth0
}

stop() {
    echo "Stopping network..."
    ifdown -f eth0 2>/dev/null
    ifdown -f wlan0
    ifdown lo
}

case "$1" in
start|stop)
    $1
    ;;

restart|reload)
    stop
    start
    ;;

*)
    echo "Usage: $0 {start|stop|restart|reload}"
    exit 1
    ;;
esac