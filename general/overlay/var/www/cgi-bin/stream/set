#!/bin/sh
. "$(dirname "$0")/_common.sh"
log_call

param=$(qs_get param)
value=$(qs_get value)

if [ -z "$param" ] || [ -z "$value" ]; then
    respond_error "missing param or value"
    exit 0
fi

if ! is_valid_param "$param"; then
    respond_error "invalid param: $param"
    exit 0
fi

set_and_reload "$param" "$value"

respond_json "{\"status\":\"ok\",\"action\":\"set\",\"param\":\"$param\",\"value\":\"$value\"}"